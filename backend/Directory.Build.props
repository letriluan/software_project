<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CS1591 missing XML docs; CA1848/CA1873 LoggerMessage source-gen suggestions; CA1725 parameter names -->
    <NoWarn>$(NoWarn);CS1591;CA1848;CA1873;CA1725</NoWarn>
  </PropertyGroup>
</Project>
