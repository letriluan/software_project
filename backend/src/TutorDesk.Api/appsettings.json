{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=tutordesk;Username=tutordesk;Password=tutordesk"
  },
  "Jwt": {
    "Issuer": "tutordesk",
    "Audience": "tutordesk",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SecureCookies": true
  },
  "Seed": {
    "MigrateOnStartup": true,
    "DemoData": false
  },
  "RateLimiting": {
    "LoginPerMinute": 10
  },
  "Api": {
    "ExposeDocs": false
  }
}
